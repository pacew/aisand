#!/bin/bash
set -e

# Refuse to run inside a container
if [ -f /.dockerenv ]; then
  echo "Error: aisand cannot be run inside an aisand container"
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DOCKERFILE="$SCRIPT_DIR/Dockerfile"

if [ ! -f "$DOCKERFILE" ]; then
  echo "Error: Dockerfile not found at $DOCKERFILE"
  exit 1
fi

# A single image is shared across all aisand projects.
IMAGE_TAG="aisand"

# User-level config, XDG Base Directory spec. Holds the same keys as a
# project's ./aisand.json, so anything added there later works here too;
# for now only extra_packages is meaningful at this level.
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aisand"
USER_CONFIG="$USER_CONFIG_DIR/config.json"

usage() {
  cat <<EOF
Usage: cd /path/to/git/repo && aisand [claude-options...]
                        run Claude Code in the sandbox (permissions bypassed;
                        the container is the trust boundary)
       aisand shell | sh | bash [args...]
                        run an interactive shell in the sandbox
       aisand rebuild [claude-options...]
                        delete and rebuild the Docker image, then run Claude Code
       aisand add PKG...
                        add apt packages wanted in every project
       aisand delete PKG...
                        remove apt packages from the every-project list
       aisand list      show the config files and the resulting package list
       aisand prune     remove all aisand images and volumes

Every-project packages live in $USER_CONFIG
Per-project packages and ports live in ./aisand.json
EOF
}

need_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq not found on host (needed to read aisand config files)"
    exit 1
  fi
}

# Rewrite $USER_CONFIG by piping it through a jq filter. Any positional
# arguments become $ARGS.positional inside the filter.
edit_user_config() {
  local filter="$1"; shift
  need_jq
  mkdir -p "$USER_CONFIG_DIR"
  [ -f "$USER_CONFIG" ] || echo '{}' > "$USER_CONFIG"
  local tmp
  tmp="$(mktemp)"
  jq "$filter" --args "$@" < "$USER_CONFIG" > "$tmp"
  mv "$tmp" "$USER_CONFIG"
}

show_packages() {
  local file="$1"
  jq -r '(.extra_packages // []) | if length == 0 then "  (none)" else map("  " + .) | .[] end' "$file"
}

# Argument dispatch. Anything that isn't a recognized subcommand is either a
# claude option (leading '-') or a mistake. The chosen command is handed to
# `docker run` at the bottom of this script, replacing the image's CMD.
#
# --dangerously-skip-permissions is always passed: the whole point of aisand is
# that the container, not Claude Code's permission prompts, is the trust
# boundary. /bin/bash rather than $SHELL because $SHELL is the host's shell and
# need not exist in the image; /bin/bash is what the generated /etc/passwd says.
REBUILD=0
case "${1-}" in
  ""|-*)
    CONTAINER_CMD=(claude --dangerously-skip-permissions "$@")
    ;;
  shell|sh|bash)
    shift
    CONTAINER_CMD=(/bin/bash "$@")
    ;;
  rebuild)
    REBUILD=1
    shift
    CONTAINER_CMD=(claude --dangerously-skip-permissions "$@")
    ;;
  add)
    shift
    [ $# -eq 0 ] && { usage; exit 1; }
    edit_user_config '.extra_packages = ((.extra_packages // []) + $ARGS.positional | unique)' "$@"
    echo "$USER_CONFIG"
    show_packages "$USER_CONFIG"
    exit 0
    ;;
  delete)
    shift
    [ $# -eq 0 ] && { usage; exit 1; }
    edit_user_config '.extra_packages = ((.extra_packages // []) - $ARGS.positional)' "$@"
    echo "$USER_CONFIG"
    show_packages "$USER_CONFIG"
    exit 0
    ;;
  list)
    need_jq
    echo "$USER_CONFIG"
    if [ -f "$USER_CONFIG" ]; then
      show_packages "$USER_CONFIG"
    else
      echo "  (no such file)"
    fi
    if [ -f ./aisand.json ]; then
      echo "$(pwd)/aisand.json"
      show_packages ./aisand.json
    fi
    exit 0
    ;;
  prune)
    echo "Removing all aisand images and volumes..."
    docker images -q --filter 'reference=aisand*' \
      | xargs --no-run-if-empty docker rmi -f
    docker volume ls -q --filter 'name=^aisand-' \
      | xargs --no-run-if-empty docker volume rm
    echo "Cleanup complete."
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac

# Allow .git to be either a directory (normal clone) or a file (worktree)
if [ ! -e .git ]; then
  echo "Error: Not in a git repository root (no .git found)"
  usage
  exit 1
fi

if [ -z "$ANTHROPIC_API_KEY" ]; then
  echo "Error: ANTHROPIC_API_KEY not set in environment"
  echo "Set it with: export ANTHROPIC_API_KEY=\"sk-ant-...\""
  exit 1
fi

REPO_ROOT="$(pwd)"
REPO_NAME="$(basename "$REPO_ROOT")"
REPO_NAME_SAFE="$(echo -n "$REPO_NAME" | tr -c 'a-zA-Z0-9._-' '_')"
PATH_HASH="$(echo -n "$REPO_ROOT" | sha256sum | cut -c1-8)"
MEMORY_VOLUME="aisand-${REPO_NAME_SAFE}-${PATH_HASH}-memory"

PROJECT_CONFIG="$REPO_ROOT/aisand.json"

# Two optional config layers, both in the same JSON format:
#
#   $USER_CONFIG            (managed by aisand add/delete/list)
#     extra_packages : apt packages wanted in every project
#   $PROJECT_CONFIG         (./aisand.json, hand-edited, may be committed)
#     extra_packages : apt packages wanted only in this project
#     html_port      : int, forwarded as -p N:N (host → container, same port)
#     ssl_port       : int, ditto
#
# The two extra_packages lists are unioned into one derivative image. Ports are
# project-only; they describe a specific application, not a user preference.
EXTRA_PACKAGES=""
HTML_PORT=""
SSL_PORT=""

CONFIG_FILES=()
[ -f "$USER_CONFIG" ] && CONFIG_FILES+=("$USER_CONFIG")
[ -f "$PROJECT_CONFIG" ] && CONFIG_FILES+=("$PROJECT_CONFIG")

if [ ${#CONFIG_FILES[@]} -gt 0 ]; then
  need_jq
  EXTRA_PACKAGES="$(jq -rs 'map(.extra_packages // []) | add | unique | join(" ")' "${CONFIG_FILES[@]}")"
fi

if [ -f "$PROJECT_CONFIG" ]; then
  HTML_PORT="$(jq -r '.html_port // empty' "$PROJECT_CONFIG")"
  SSL_PORT="$(jq -r '.ssl_port  // empty' "$PROJECT_CONFIG")"
fi

# If extra_packages is non-empty, layer them onto the shared base image in a
# derivative image tagged by a hash of the package set itself. Every project
# asking for the same packages therefore shares one image, and editing either
# config file names a different tag — so the tag *is* the cache key and there
# is nothing to invalidate. jq's `unique` has already sorted and deduped the
# list, so the hash does not depend on the order the packages were added in.
DERIVED_IMAGE=""
if [ -n "$EXTRA_PACKAGES" ]; then
  DERIVED_IMAGE="aisand-pkgs-$(echo -n "$EXTRA_PACKAGES" | sha256sum | cut -c1-12)"
fi
IMAGE_TO_USE="${DERIVED_IMAGE:-$IMAGE_TAG}"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "aisand: Claude Code Sandbox"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Repository:    $REPO_ROOT"
echo "Image:         $IMAGE_TO_USE"
echo "Memory volume: $MEMORY_VOLUME"
[ -n "$EXTRA_PACKAGES" ] && echo "Extra pkgs:    $EXTRA_PACKAGES"
[ -n "$HTML_PORT" ] && echo "HTML port:     $HTML_PORT (host → container)"
[ -n "$SSL_PORT" ]  && echo "SSL port:      $SSL_PORT (host → container)"
echo ""

if [ "$REBUILD" -eq 1 ]; then
  echo "Removing base image: $IMAGE_TAG"
  docker image rm "$IMAGE_TAG" 2>/dev/null || true
  if [ -n "$DERIVED_IMAGE" ]; then
    echo "Removing derived image: $DERIVED_IMAGE"
    docker image rm "$DERIVED_IMAGE" 2>/dev/null || true
  fi
fi

if ! docker image inspect "$IMAGE_TAG" > /dev/null 2>&1; then
  echo "Building base Docker image (this takes a minute)..."
  docker build -f "$DOCKERFILE" -t "$IMAGE_TAG" "$SCRIPT_DIR"
else
  echo "Using cached base image"
fi

# The tag encodes the package set, so mere existence means it is current. The
# label records the human-readable list, so `docker image inspect` (or
# `docker images --filter label=...`) can say what a hashed tag contains.
if [ -n "$DERIVED_IMAGE" ]; then
  if docker image inspect "$DERIVED_IMAGE" > /dev/null 2>&1; then
    echo "Using cached derived image"
  else
    echo "Building derived image with extra packages: $EXTRA_PACKAGES"
    docker build -t "$DERIVED_IMAGE" \
      --label "aisand.extra_packages=$EXTRA_PACKAGES" \
      - <<EOF
FROM $IMAGE_TAG
RUN apt-get update && apt-get install -y --no-install-recommends \\
    $EXTRA_PACKAGES \\
    && rm -rf /var/lib/apt/lists/*
EOF
  fi
fi

# Create the memory volume if needed, and chown it to the host user so
# the non-root container process can write to it.
if ! docker volume inspect "$MEMORY_VOLUME" > /dev/null 2>&1; then
  echo "Creating memory volume..."
  docker volume create "$MEMORY_VOLUME" > /dev/null
  echo "Initializing memory volume ownership..."
  docker run --rm --user root \
    -v "$MEMORY_VOLUME:/init" \
    "$IMAGE_TAG" \
    chown "$(id -u):$(id -g)" /init
fi

# Generate /etc/passwd and /etc/group entries so the host user has a
# proper identity inside the container (no "I have no name!" prompt,
# git/npm/etc. can resolve $HOME and $USER).
PASSWD_FILE="$(mktemp)"
GROUP_FILE="$(mktemp)"
trap 'rm -f "$PASSWD_FILE" "$GROUP_FILE"' EXIT

cat > "$PASSWD_FILE" <<EOF
root:x:0:0:root:/root:/bin/bash
${USER}:x:$(id -u):$(id -g):${USER}:${HOME}:/bin/bash
EOF

cat > "$GROUP_FILE" <<EOF
root:x:0:
${USER}:x:$(id -g):
EOF

# Pre-seed Claude Code config so the first-run dialogs (onboarding, trust,
# theme, API-key approval) are answered without prompting. Re-seeded each
# run because ~/.claude.json lives in tmpfs $HOME.
#
# We copy the API-key approval list from the host's ~/.claude.json if
# present, so the same API key isn't re-prompted in the container.
API_KEY_APPROVALS='[]'
if [ -f "$HOME/.claude.json" ] && command -v python3 >/dev/null 2>&1; then
  API_KEY_APPROVALS=$(python3 - "$HOME/.claude.json" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print(json.dumps(d.get('customApiKeyResponses', {}).get('approved', [])))
except Exception:
    print('[]')
PY
)
fi

CLAUDE_CONFIG=$(cat <<EOF
{
  "hasCompletedOnboarding": true,
  "theme": "dark",
  "customApiKeyResponses": {"approved": ${API_KEY_APPROVALS}, "rejected": []},
  "projects": {
    "${REPO_ROOT}": {
      "hasTrustDialogAccepted": true,
      "projectOnboardingSeenCount": 1
    }
  }
}
EOF
)

# Optional mount of host ~/.gitconfig so git commits get the host user's
# name and email. Read-only so the container can't modify it.
GITCONFIG_MOUNT=()
if [ -f "$HOME/.gitconfig" ]; then
  GITCONFIG_MOUNT=(-v "$HOME/.gitconfig:$HOME/.gitconfig:ro")
fi

# Host→container port forwarding for apache or similar. Same port number on
# both sides keeps URLs symmetric (localhost:9999 on host == 9999 in apache
# config inside the container). Docker binds 0.0.0.0 by default, so external
# DNS (e.g. k.pacew.org:9999) reaches the container too.
PORT_FLAGS=()
[ -n "$HTML_PORT" ] && PORT_FLAGS+=(-p "${HTML_PORT}:${HTML_PORT}")
[ -n "$SSL_PORT" ]  && PORT_FLAGS+=(-p "${SSL_PORT}:${SSL_PORT}")

# Read-only mount of host apache certs at the same path inside the container,
# so apache config can reference /etc/apache2/foo.crt as-is.
SSL_CERT_MOUNTS=()
shopt -s nullglob
for f in /etc/apache2/*.crt /etc/apache2/*.key /etc/apache2/*.chain.pem; do
  SSL_CERT_MOUNTS+=(-v "$f:$f:ro")
done
shopt -u nullglob

echo "Launching: ${CONTAINER_CMD[*]}"
echo "Project: $REPO_ROOT"
echo "Exiting the command destroys the container"
echo ""

docker run --rm -it \
  --user "$(id -u):$(id -g)" \
  --hostname "aisand-${REPO_NAME_SAFE}" \
  --security-opt=no-new-privileges \
  --cap-drop=all \
  --memory=4g \
  --cpus=4 \
  --tmpfs "$HOME":uid=$(id -u),gid=$(id -g),mode=755,size=512m \
  -w "$REPO_ROOT" \
  -e HOME="$HOME" \
  -e USER="$USER" \
  -e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
  -e AISAND_CLAUDE_CONFIG="$CLAUDE_CONFIG" \
  -v "$PASSWD_FILE:/etc/passwd:ro" \
  -v "$GROUP_FILE:/etc/group:ro" \
  -v "$REPO_ROOT:$REPO_ROOT" \
  -v "$MEMORY_VOLUME:$HOME/.claude" \
  "${GITCONFIG_MOUNT[@]}" \
  "${PORT_FLAGS[@]}" \
  "${SSL_CERT_MOUNTS[@]}" \
  "$IMAGE_TO_USE" \
  "${CONTAINER_CMD[@]}"

echo ""
echo "Container destroyed. Project files and memory remain on disk."
