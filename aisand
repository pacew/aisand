#!/bin/bash
set -e

# Refuse to run inside a container
if [ -f /.dockerenv ]; then
  echo "Error: aisand cannot be run inside an aisand container"
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DOCKERFILE="$SCRIPT_DIR/Dockerfile"

if [ ! -f "$DOCKERFILE" ]; then
  echo "Error: Dockerfile not found at $DOCKERFILE"
  exit 1
fi

# A single image is shared across all aisand projects.
IMAGE_TAG="aisand"

if [ "$1" == "prune" ]; then
  echo "Removing all aisand images and volumes..."
  docker images -q --filter 'reference=aisand*' \
    | xargs --no-run-if-empty docker rmi -f
  docker volume ls -q --filter 'name=^aisand-' \
    | xargs --no-run-if-empty docker volume rm
  echo "Cleanup complete."
  exit 0
fi

REBUILD=0
if [ "$1" == "rebuild" ]; then
  REBUILD=1
fi

# Allow .git to be either a directory (normal clone) or a file (worktree)
if [ ! -e .git ]; then
  echo "Error: Not in a git repository root (no .git found)"
  echo "Usage: cd /path/to/git/repo && aisand"
  echo "       aisand rebuild   (delete and rebuild Docker image, then launch)"
  echo "       aisand prune     (remove all aisand images and volumes)"
  exit 1
fi

if [ -z "$ANTHROPIC_API_KEY" ]; then
  echo "Error: ANTHROPIC_API_KEY not set in environment"
  echo "Set it with: export ANTHROPIC_API_KEY=\"sk-ant-...\""
  exit 1
fi

REPO_ROOT="$(pwd)"
REPO_NAME="$(basename "$REPO_ROOT")"
REPO_NAME_SAFE="$(echo -n "$REPO_NAME" | tr -c 'a-zA-Z0-9._-' '_')"
PATH_HASH="$(echo -n "$REPO_ROOT" | sha256sum | cut -c1-8)"
MEMORY_VOLUME="aisand-${REPO_NAME_SAFE}-${PATH_HASH}-memory"

# Optional per-project config: $REPO_ROOT/aisand.json
#   extra_packages : list of apt packages installed into a derivative image
#   html_port      : int, forwarded as -p N:N (host → container, same port)
#   ssl_port       : int, ditto
EXTRA_PACKAGES=""
HTML_PORT=""
SSL_PORT=""
if [ -f "$REPO_ROOT/aisand.json" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: aisand.json present but jq not found on host"
    exit 1
  fi
  EXTRA_PACKAGES="$(jq -r '(.extra_packages // []) | join(" ")' "$REPO_ROOT/aisand.json")"
  HTML_PORT="$(jq -r '.html_port // empty' "$REPO_ROOT/aisand.json")"
  SSL_PORT="$(jq -r '.ssl_port  // empty' "$REPO_ROOT/aisand.json")"
fi

# If extra_packages is set, layer them onto the base image in a per-project
# derivative image. The base image stays shared; only the layer differs.
DERIVED_IMAGE=""
if [ -n "$EXTRA_PACKAGES" ]; then
  DERIVED_IMAGE="aisand-${REPO_NAME_SAFE}-${PATH_HASH}"
fi
IMAGE_TO_USE="${DERIVED_IMAGE:-$IMAGE_TAG}"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "aisand: Claude Code Sandbox"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Repository:    $REPO_ROOT"
echo "Image:         $IMAGE_TO_USE"
echo "Memory volume: $MEMORY_VOLUME"
[ -n "$EXTRA_PACKAGES" ] && echo "Extra pkgs:    $EXTRA_PACKAGES"
[ -n "$HTML_PORT" ] && echo "HTML port:     $HTML_PORT (host → container)"
[ -n "$SSL_PORT" ]  && echo "SSL port:      $SSL_PORT (host → container)"
echo ""

if [ "$REBUILD" -eq 1 ]; then
  echo "Removing base image: $IMAGE_TAG"
  docker image rm "$IMAGE_TAG" 2>/dev/null || true
  if [ -n "$DERIVED_IMAGE" ]; then
    echo "Removing derived image: $DERIVED_IMAGE"
    docker image rm "$DERIVED_IMAGE" 2>/dev/null || true
  fi
fi

if ! docker image inspect "$IMAGE_TAG" > /dev/null 2>&1; then
  echo "Building base Docker image (this takes a minute)..."
  docker build -f "$DOCKERFILE" -t "$IMAGE_TAG" "$SCRIPT_DIR"
else
  echo "Using cached base image"
fi

if [ -n "$DERIVED_IMAGE" ]; then
  EXTRA_HASH="$(echo -n "$EXTRA_PACKAGES" | sha256sum | cut -c1-12)"
  EXISTING_HASH="$(docker image inspect -f '{{ index .Config.Labels "aisand.extra_packages_hash" }}' "$DERIVED_IMAGE" 2>/dev/null || true)"
  if [ "$EXISTING_HASH" != "$EXTRA_HASH" ]; then
    echo "Building derived image with extra packages: $EXTRA_PACKAGES"
    docker build -t "$DERIVED_IMAGE" \
      --label "aisand.extra_packages_hash=$EXTRA_HASH" \
      - <<EOF
FROM $IMAGE_TAG
RUN apt-get update && apt-get install -y --no-install-recommends \\
    $EXTRA_PACKAGES \\
    && rm -rf /var/lib/apt/lists/*
EOF
  else
    echo "Using cached derived image"
  fi
fi

# Create the memory volume if needed, and chown it to the host user so
# the non-root container process can write to it.
if ! docker volume inspect "$MEMORY_VOLUME" > /dev/null 2>&1; then
  echo "Creating memory volume..."
  docker volume create "$MEMORY_VOLUME" > /dev/null
  echo "Initializing memory volume ownership..."
  docker run --rm --user root \
    -v "$MEMORY_VOLUME:/init" \
    "$IMAGE_TAG" \
    chown "$(id -u):$(id -g)" /init
fi

# Generate /etc/passwd and /etc/group entries so the host user has a
# proper identity inside the container (no "I have no name!" prompt,
# git/npm/etc. can resolve $HOME and $USER).
PASSWD_FILE="$(mktemp)"
GROUP_FILE="$(mktemp)"
trap 'rm -f "$PASSWD_FILE" "$GROUP_FILE"' EXIT

cat > "$PASSWD_FILE" <<EOF
root:x:0:0:root:/root:/bin/bash
${USER}:x:$(id -u):$(id -g):${USER}:${HOME}:/bin/bash
EOF

cat > "$GROUP_FILE" <<EOF
root:x:0:
${USER}:x:$(id -g):
EOF

# Pre-seed Claude Code config so the first-run dialogs (onboarding, trust,
# theme, API-key approval) are answered without prompting. Re-seeded each
# run because ~/.claude.json lives in tmpfs $HOME.
#
# We copy the API-key approval list from the host's ~/.claude.json if
# present, so the same API key isn't re-prompted in the container.
API_KEY_APPROVALS='[]'
if [ -f "$HOME/.claude.json" ] && command -v python3 >/dev/null 2>&1; then
  API_KEY_APPROVALS=$(python3 - "$HOME/.claude.json" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print(json.dumps(d.get('customApiKeyResponses', {}).get('approved', [])))
except Exception:
    print('[]')
PY
)
fi

CLAUDE_CONFIG=$(cat <<EOF
{
  "hasCompletedOnboarding": true,
  "theme": "dark",
  "customApiKeyResponses": {"approved": ${API_KEY_APPROVALS}, "rejected": []},
  "projects": {
    "${REPO_ROOT}": {
      "hasTrustDialogAccepted": true,
      "projectOnboardingSeenCount": 1
    }
  }
}
EOF
)

# Optional mount of host ~/.gitconfig so git commits get the host user's
# name and email. Read-only so the container can't modify it.
GITCONFIG_MOUNT=()
if [ -f "$HOME/.gitconfig" ]; then
  GITCONFIG_MOUNT=(-v "$HOME/.gitconfig:$HOME/.gitconfig:ro")
fi

# Host→container port forwarding for apache or similar. Same port number on
# both sides keeps URLs symmetric (localhost:9999 on host == 9999 in apache
# config inside the container). Docker binds 0.0.0.0 by default, so external
# DNS (e.g. k.pacew.org:9999) reaches the container too.
PORT_FLAGS=()
[ -n "$HTML_PORT" ] && PORT_FLAGS+=(-p "${HTML_PORT}:${HTML_PORT}")
[ -n "$SSL_PORT" ]  && PORT_FLAGS+=(-p "${SSL_PORT}:${SSL_PORT}")

# Read-only mount of host apache certs at the same path inside the container,
# so apache config can reference /etc/apache2/foo.crt as-is.
SSL_CERT_MOUNTS=()
shopt -s nullglob
for f in /etc/apache2/*.crt /etc/apache2/*.key /etc/apache2/*.chain.pem; do
  SSL_CERT_MOUNTS+=(-v "$f:$f:ro")
done
shopt -u nullglob

echo "Launching interactive shell..."
echo "Project: $REPO_ROOT"
echo "Exit with Ctrl+D or 'exit' to destroy the container"
echo ""

docker run --rm -it \
  --user "$(id -u):$(id -g)" \
  --hostname "aisand-${REPO_NAME_SAFE}" \
  --security-opt=no-new-privileges \
  --cap-drop=all \
  --memory=4g \
  --cpus=4 \
  --tmpfs "$HOME":uid=$(id -u),gid=$(id -g),mode=755,size=512m \
  -w "$REPO_ROOT" \
  -e HOME="$HOME" \
  -e USER="$USER" \
  -e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
  -e AISAND_CLAUDE_CONFIG="$CLAUDE_CONFIG" \
  -v "$PASSWD_FILE:/etc/passwd:ro" \
  -v "$GROUP_FILE:/etc/group:ro" \
  -v "$REPO_ROOT:$REPO_ROOT" \
  -v "$MEMORY_VOLUME:$HOME/.claude" \
  "${GITCONFIG_MOUNT[@]}" \
  "${PORT_FLAGS[@]}" \
  "${SSL_CERT_MOUNTS[@]}" \
  "$IMAGE_TO_USE"

echo ""
echo "Container destroyed. Project files and memory remain on disk."
