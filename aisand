#!/bin/bash
set -e

# Refuse to run inside a container
if [ -f /.dockerenv ]; then
  echo "Error: aisand cannot be run inside an aisand container"
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DOCKERFILE="$SCRIPT_DIR/Dockerfile"

if [ ! -f "$DOCKERFILE" ]; then
  echo "Error: Dockerfile not found at $DOCKERFILE"
  exit 1
fi

# A single image is shared across all aisand projects.
IMAGE_TAG="aisand"

# User-level config, XDG Base Directory spec. Holds the same keys as a
# project's ./aisand.json, so anything added there later works here too;
# for now only extra_packages is meaningful at this level.
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aisand"
USER_CONFIG="$USER_CONFIG_DIR/config.json"

usage() {
  cat <<EOF
Usage: cd /path/to/git/repo && aisand [claude-options...]
                        run Claude Code in the sandbox (permissions bypassed;
                        the container is the trust boundary)
       aisand shell | sh | bash [args...]
                        run an interactive shell in the sandbox
       aisand rebuild [claude-options...]
                        delete and rebuild the Docker image, then run Claude Code
       aisand add PKG...
                        add apt packages wanted in every project
       aisand delete PKG...
                        remove apt packages from the every-project list
       aisand list      show the config files and the resulting package list
       aisand prune     remove all aisand images; memory volumes are kept
       aisand memory    list memory volumes with project, size, and age
       aisand forget [PATH...]
                        delete the memory volume for those projects (default: .)

Every-project packages live in $USER_CONFIG
Per-project packages, pip packages, and ports live in ./aisand.json
EOF
}

need_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq not found on host (needed to read aisand config files)"
    exit 1
  fi
}

# Rewrite $USER_CONFIG by piping it through a jq filter. Any positional
# arguments become $ARGS.positional inside the filter.
edit_user_config() {
  local filter="$1"; shift
  need_jq
  mkdir -p "$USER_CONFIG_DIR"
  [ -f "$USER_CONFIG" ] || echo '{}' > "$USER_CONFIG"
  local tmp
  tmp="$(mktemp)"
  jq "$filter" --args "$@" < "$USER_CONFIG" > "$tmp"
  mv "$tmp" "$USER_CONFIG"
}

show_packages() {
  local file="$1"
  jq -r '
    (.extra_packages // []) as $apt | (.pip_packages // []) as $pip |
    if ($apt + $pip | length) == 0 then "  (none)"
    else
      (if ($apt | length) > 0 then "  apt:", ($apt[] | "    " + .) else empty end),
      (if ($pip | length) > 0 then "  pip:", ($pip[] | "    " + .) else empty end)
    end
  ' "$file"
}

# Memory volume name for a project directory. Must match what the launch path
# below creates: basename for legibility, path hash so that same-named repos in
# different directories stay apart. The hash is one-way, which is why volumes
# also carry an aisand.repo_root label (see `aisand memory`).
memory_volume_for() {
  local root name_safe hash
  root="$(cd "$1" && pwd)"
  name_safe="$(printf '%s' "$(basename "$root")" | tr -c 'a-zA-Z0-9._-' '_')"
  hash="$(printf '%s' "$root" | sha256sum | cut -c1-8)"
  echo "aisand-${name_safe}-${hash}-memory"
}

# Argument dispatch. Anything that isn't a recognized subcommand is either a
# claude option (leading '-') or a mistake. The chosen command is handed to
# `docker run` at the bottom of this script, replacing the image's CMD.
#
# --dangerously-skip-permissions is always passed: the whole point of aisand is
# that the container, not Claude Code's permission prompts, is the trust
# boundary. /bin/bash rather than $SHELL because $SHELL is the host's shell and
# need not exist in the image; /bin/bash is what the generated /etc/passwd says.
REBUILD=0
case "${1-}" in
  ""|-*)
    CONTAINER_CMD=(claude --dangerously-skip-permissions "$@")
    ;;
  shell|sh|bash)
    shift
    CONTAINER_CMD=(/bin/bash "$@")
    ;;
  rebuild)
    REBUILD=1
    shift
    CONTAINER_CMD=(claude --dangerously-skip-permissions "$@")
    ;;
  add)
    shift
    [ $# -eq 0 ] && { usage; exit 1; }
    edit_user_config '.extra_packages = ((.extra_packages // []) + $ARGS.positional | unique)' "$@"
    echo "$USER_CONFIG"
    show_packages "$USER_CONFIG"
    exit 0
    ;;
  delete)
    shift
    [ $# -eq 0 ] && { usage; exit 1; }
    edit_user_config '.extra_packages = ((.extra_packages // []) - $ARGS.positional)' "$@"
    echo "$USER_CONFIG"
    show_packages "$USER_CONFIG"
    exit 0
    ;;
  list)
    need_jq
    echo "$USER_CONFIG"
    if [ -f "$USER_CONFIG" ]; then
      show_packages "$USER_CONFIG"
    else
      echo "  (no such file)"
    fi
    if [ -f ./aisand.json ]; then
      echo "$(pwd)/aisand.json"
      show_packages ./aisand.json
    fi
    exit 0
    ;;
  prune)
    # Images only. They are wholly derivable from the Dockerfile plus the two
    # config files, so destroying them costs a rebuild and nothing else. Memory
    # volumes are the one artifact here that cannot be regenerated from
    # anything on disk, and they are a rounding error on disk anyway (tens of
    # MB against multiple GB of images), so sweeping them up was never buying
    # space. Deleting memory now requires `aisand forget`.
    echo "Removing all aisand images..."
    docker images -q --filter 'reference=aisand*' \
      | xargs --no-run-if-empty docker rmi -f
    KEPT="$(docker volume ls -q --filter 'name=^aisand-' | grep -c -- '-memory$' || true)"
    echo "Cleanup complete. Kept $KEPT memory volumes — see \`aisand memory\`"
    exit 0
    ;;
  memory)
    need_jq
    CURRENT=""
    [ -e .git ] && CURRENT="$(memory_volume_for .)"
    # `docker volume ls` reports no size and `docker volume inspect` no size
    # either; only `system df -v` knows, at the cost of a full scan. That is
    # why size lives here and not in prune's summary line.
    printf '%s %-38s %-30s %-10s %s\n' " " VOLUME PROJECT SIZE CREATED
    docker system df -v --format '{{json .Volumes}}' \
      | jq -r --arg current "$CURRENT" '
          [ .[] | select(.Name | test("^aisand-.*-memory$")) ]
          | sort_by(.Name)[] as $v
          | (($v.Labels // "") | split(",")
              | map(select(startswith("aisand.repo_root=")))
              | (.[0] // "") | sub("^aisand\\.repo_root="; "")) as $root
          | [ (if $v.Name == $current then "*" else " " end),
              $v.Name,
              # Unlabeled volume: the path hash is one-way, so fall back to the
              # basename the name already carries. Done here rather than in the
              # shell because tab is an IFS whitespace character, so `read`
              # collapses empty fields and would shift every later column.
              (if $root == "" then
                 ($v.Name | sub("^aisand-"; "") | sub("-[0-9a-f]{8}-memory$"; "")) + " (?)"
               else $root end),
              $v.Size ]
          | @tsv' \
      | while IFS=$'\t' read -r mark name proj size; do
          created="$(docker volume inspect -f '{{.CreatedAt}}' "$name" | cut -c1-10)"
          printf '%s %-38s %-30s %-10s %s\n' "$mark" "$name" "$proj" "$size" "$created"
        done
    exit 0
    ;;
  forget)
    shift
    [ $# -eq 0 ] && set -- .
    for target in "$@"; do
      # Without this the failing `cd` inside memory_volume_for still returns a
      # name — built from an empty basename and the hash of an empty string —
      # and we would report on a volume nobody has.
      [ -d "$target" ] || { echo "Error: no such directory: $target"; exit 1; }
      VOL="$(memory_volume_for "$target")"
      if docker volume inspect "$VOL" > /dev/null 2>&1; then
        docker volume rm "$VOL" > /dev/null
        echo "Deleted $VOL"
      else
        echo "No memory volume for $target ($VOL)"
      fi
    done
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac

# Allow .git to be either a directory (normal clone) or a file (worktree)
if [ ! -e .git ]; then
  echo "Error: Not in a git repository root (no .git found)"
  usage
  exit 1
fi

if [ -z "$ANTHROPIC_API_KEY" ]; then
  echo "Error: ANTHROPIC_API_KEY not set in environment"
  echo "Set it with: export ANTHROPIC_API_KEY=\"sk-ant-...\""
  exit 1
fi

REPO_ROOT="$(pwd)"
REPO_NAME_SAFE="$(printf '%s' "$(basename "$REPO_ROOT")" | tr -c 'a-zA-Z0-9._-' '_')"
MEMORY_VOLUME="$(memory_volume_for "$REPO_ROOT")"

PROJECT_CONFIG="$REPO_ROOT/aisand.json"

# Two optional config layers, both in the same JSON format:
#
#   $USER_CONFIG            (managed by aisand add/delete/list)
#     extra_packages : apt packages wanted in every project
#   $PROJECT_CONFIG         (./aisand.json, hand-edited, may be committed)
#     extra_packages : apt packages wanted only in this project
#     pip_packages   : Python packages for a venv at /opt/venv
#     html_port      : int, forwarded as -p N:N (host → container, same port)
#     ssl_port       : int, ditto
#
# extra_packages and pip_packages are each unioned across the two layers and
# baked into one derivative image. Ports are project-only; they describe a
# specific application, not a user preference. pip_packages is accepted at
# either layer for symmetry, but belongs in the project file in practice — a
# user-level Python dep would be installed into every project's image.
EXTRA_PACKAGES=""
PIP_PACKAGES=""
HTML_PORT=""
SSL_PORT=""

CONFIG_FILES=()
[ -f "$USER_CONFIG" ] && CONFIG_FILES+=("$USER_CONFIG")
[ -f "$PROJECT_CONFIG" ] && CONFIG_FILES+=("$PROJECT_CONFIG")

if [ ${#CONFIG_FILES[@]} -gt 0 ]; then
  need_jq
  EXTRA_PACKAGES="$(jq -rs 'map(.extra_packages // []) | add | unique | join(" ")' "${CONFIG_FILES[@]}")"
  PIP_PACKAGES="$(jq -rs 'map(.pip_packages   // []) | add | unique | join(" ")' "${CONFIG_FILES[@]}")"
fi

if [ -f "$PROJECT_CONFIG" ]; then
  HTML_PORT="$(jq -r '.html_port // empty' "$PROJECT_CONFIG")"
  SSL_PORT="$(jq -r '.ssl_port  // empty' "$PROJECT_CONFIG")"
fi

# If either package list is non-empty, layer them onto the shared base image in
# a derivative image tagged by a hash of the package sets themselves. Every
# project asking for the same packages therefore shares one image, and editing
# either config file names a different tag — so the tag *is* the cache key and
# there is nothing to invalidate. jq's `unique` has already sorted and deduped
# both lists, so the hash does not depend on the order packages were added in.
#
# One hash over both lists, not one per list: the image is a function of the
# pair, so two hashes would name something that does not exist. The newline
# keeps apt=[x],pip=[] distinct from apt=[],pip=[x].
DERIVED_IMAGE=""
if [ -n "$EXTRA_PACKAGES" ] || [ -n "$PIP_PACKAGES" ]; then
  DERIVED_IMAGE="aisand-pkgs-$(printf '%s\n%s' "$EXTRA_PACKAGES" "$PIP_PACKAGES" \
    | sha256sum | cut -c1-12)"
fi
IMAGE_TO_USE="${DERIVED_IMAGE:-$IMAGE_TAG}"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "aisand: Claude Code Sandbox"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Repository:    $REPO_ROOT"
echo "Image:         $IMAGE_TO_USE"
echo "Memory volume: $MEMORY_VOLUME"
[ -n "$EXTRA_PACKAGES" ] && echo "Extra pkgs:    $EXTRA_PACKAGES"
[ -n "$PIP_PACKAGES" ] && echo "Pip pkgs:      $PIP_PACKAGES (venv at /opt/venv, first on PATH)"
[ -n "$HTML_PORT" ] && echo "HTML port:     $HTML_PORT (host → container)"
[ -n "$SSL_PORT" ]  && echo "SSL port:      $SSL_PORT (host → container)"
echo ""

if [ "$REBUILD" -eq 1 ]; then
  echo "Removing base image: $IMAGE_TAG"
  docker image rm "$IMAGE_TAG" 2>/dev/null || true
  if [ -n "$DERIVED_IMAGE" ]; then
    echo "Removing derived image: $DERIVED_IMAGE"
    docker image rm "$DERIVED_IMAGE" 2>/dev/null || true
  fi
fi

if ! docker image inspect "$IMAGE_TAG" > /dev/null 2>&1; then
  echo "Building base Docker image (this takes a minute)..."
  docker build -f "$DOCKERFILE" -t "$IMAGE_TAG" "$SCRIPT_DIR"
else
  echo "Using cached base image"
fi

# The tag encodes the package sets, so mere existence means it is current. The
# labels record the human-readable lists, so `docker image inspect` (or
# `docker images --filter label=...`) can say what a hashed tag contains.
#
# apt runs before pip because a wheel may need headers or libraries from it.
#
# The venv is deliberately NOT --system-site-packages. With system site
# packages visible, pip's resolver counts Debian's python3-numpy (1.24.2 on
# bookworm) as satisfying an unpinned `numpy` requirement and silently declines
# to install a current one; the failure then surfaces as a confusing error deep
# inside whatever needed the newer numpy. An isolated venv gives one coherent
# Python instead of an apt/pip mixture whose behaviour depends on resolution
# order. Consequence: apt python3-* packages are invisible to `python3` once
# pip_packages is set — put those deps in pip_packages instead.
# /usr/bin/python3 still reaches the system interpreter if it is ever wanted.
#
# --no-cache-dir because changing pip_packages invalidates this layer wholesale
# anyway, so a baked pip cache would only inflate the image.
if [ -n "$DERIVED_IMAGE" ]; then
  if docker image inspect "$DERIVED_IMAGE" > /dev/null 2>&1; then
    echo "Using cached derived image"
  else
    APT_STANZA=""
    if [ -n "$EXTRA_PACKAGES" ]; then
      APT_STANZA="RUN apt-get update && apt-get install -y --no-install-recommends \\
    $EXTRA_PACKAGES \\
    && rm -rf /var/lib/apt/lists/*"
    fi

    PIP_STANZA=""
    if [ -n "$PIP_PACKAGES" ]; then
      PIP_STANZA="RUN python3 -m venv /opt/venv \\
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip wheel \\
    && /opt/venv/bin/pip install --no-cache-dir $PIP_PACKAGES
ENV PATH=/opt/venv/bin:\$PATH"
    fi

    echo "Building derived image"
    [ -n "$EXTRA_PACKAGES" ] && echo "  apt: $EXTRA_PACKAGES"
    [ -n "$PIP_PACKAGES" ] && echo "  pip: $PIP_PACKAGES"
    docker build -t "$DERIVED_IMAGE" \
      --label "aisand.extra_packages=$EXTRA_PACKAGES" \
      --label "aisand.pip_packages=$PIP_PACKAGES" \
      - <<EOF
FROM $IMAGE_TAG
$APT_STANZA
$PIP_STANZA
EOF
  fi
fi

# Create the memory volume if needed, and chown it to the host user so
# the non-root container process can write to it.
#
# The aisand.repo_root label is what lets `aisand memory` name the project a
# volume belongs to: the volume name only carries a basename plus a one-way
# path hash. Docker has no way to add a label to an existing volume, so volumes
# created before this label existed stay unlabeled and show only a basename.
if ! docker volume inspect "$MEMORY_VOLUME" > /dev/null 2>&1; then
  echo "Creating memory volume..."
  docker volume create --label "aisand.repo_root=$REPO_ROOT" "$MEMORY_VOLUME" > /dev/null
  echo "Initializing memory volume ownership..."
  docker run --rm --user root \
    -v "$MEMORY_VOLUME:/init" \
    "$IMAGE_TAG" \
    chown "$(id -u):$(id -g)" /init
fi

# Generate /etc/passwd and /etc/group entries so the host user has a
# proper identity inside the container (no "I have no name!" prompt,
# git/npm/etc. can resolve $HOME and $USER).
PASSWD_FILE="$(mktemp)"
GROUP_FILE="$(mktemp)"
trap 'rm -f "$PASSWD_FILE" "$GROUP_FILE"' EXIT

cat > "$PASSWD_FILE" <<EOF
root:x:0:0:root:/root:/bin/bash
${USER}:x:$(id -u):$(id -g):${USER}:${HOME}:/bin/bash
EOF

cat > "$GROUP_FILE" <<EOF
root:x:0:
${USER}:x:$(id -g):
EOF

# Pre-seed Claude Code config so the first-run dialogs (onboarding, trust,
# theme, API-key approval) are answered without prompting. Re-seeded each
# run because ~/.claude.json lives in tmpfs $HOME.
#
# We copy the API-key approval list from the host's ~/.claude.json if
# present, so the same API key isn't re-prompted in the container.
API_KEY_APPROVALS='[]'
if [ -f "$HOME/.claude.json" ] && command -v python3 >/dev/null 2>&1; then
  API_KEY_APPROVALS=$(python3 - "$HOME/.claude.json" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print(json.dumps(d.get('customApiKeyResponses', {}).get('approved', [])))
except Exception:
    print('[]')
PY
)
fi

CLAUDE_CONFIG=$(cat <<EOF
{
  "hasCompletedOnboarding": true,
  "theme": "dark",
  "customApiKeyResponses": {"approved": ${API_KEY_APPROVALS}, "rejected": []},
  "projects": {
    "${REPO_ROOT}": {
      "hasTrustDialogAccepted": true,
      "projectOnboardingSeenCount": 1
    }
  }
}
EOF
)

# Optional mount of host ~/.gitconfig so git commits get the host user's
# name and email. Read-only so the container can't modify it.
GITCONFIG_MOUNT=()
if [ -f "$HOME/.gitconfig" ]; then
  GITCONFIG_MOUNT=(-v "$HOME/.gitconfig:$HOME/.gitconfig:ro")
fi

# Host→container port forwarding for apache or similar. Same port number on
# both sides keeps URLs symmetric (localhost:9999 on host == 9999 in apache
# config inside the container). Docker binds 0.0.0.0 by default, so external
# DNS (e.g. k.pacew.org:9999) reaches the container too.
PORT_FLAGS=()
[ -n "$HTML_PORT" ] && PORT_FLAGS+=(-p "${HTML_PORT}:${HTML_PORT}")
[ -n "$SSL_PORT" ]  && PORT_FLAGS+=(-p "${SSL_PORT}:${SSL_PORT}")

# Read-only mount of host apache certs at the same path inside the container,
# so apache config can reference /etc/apache2/foo.crt as-is.
SSL_CERT_MOUNTS=()
shopt -s nullglob
for f in /etc/apache2/*.crt /etc/apache2/*.key /etc/apache2/*.chain.pem; do
  SSL_CERT_MOUNTS+=(-v "$f:$f:ro")
done
shopt -u nullglob

echo "Launching: ${CONTAINER_CMD[*]}"
echo "Project: $REPO_ROOT"
echo "Exiting the command destroys the container"
echo ""

docker run --rm -it \
  --user "$(id -u):$(id -g)" \
  --hostname "aisand-${REPO_NAME_SAFE}" \
  --security-opt=no-new-privileges \
  --cap-drop=all \
  --memory=4g \
  --cpus=4 \
  --tmpfs "$HOME":uid=$(id -u),gid=$(id -g),mode=755,size=512m \
  -w "$REPO_ROOT" \
  -e HOME="$HOME" \
  -e USER="$USER" \
  -e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
  -e AISAND_CLAUDE_CONFIG="$CLAUDE_CONFIG" \
  -v "$PASSWD_FILE:/etc/passwd:ro" \
  -v "$GROUP_FILE:/etc/group:ro" \
  -v "$REPO_ROOT:$REPO_ROOT" \
  -v "$MEMORY_VOLUME:$HOME/.claude" \
  "${GITCONFIG_MOUNT[@]}" \
  "${PORT_FLAGS[@]}" \
  "${SSL_CERT_MOUNTS[@]}" \
  "$IMAGE_TO_USE" \
  "${CONTAINER_CMD[@]}"

echo ""
echo "Container destroyed. Project files and memory remain on disk."
